{
  "name": "Blue Carbon Field App",
  "short_name": "BC Field",
  "description": "Pencatatan data lapangan lamun dan mangrove untuk MRV karbon biru: GPS, foto, kode sampel QR, validasi otomatis, dan mode offline.",
  "lang": "id",
  "start_url": "./#home",
  "scope": "./",
