            { "id": "mgc-recovery", "type": "compare", "a": "recoveredLength", "op": "<=", "b": "penetrationDepth", "level": "error", "message": "Panjang sedimen terambil tidak boleh melebihi kedalaman tembus." },
            { "id": "mgc-interval", "type": "compare", "a": "depthBottom", "op": "<=", "b": "penetrationDepth", "level": "warning", "message": "Interval subsampel lebih dalam dari kedalaman tembus core." },
