          { "id": "mg-trees", "type": "minRows", "table": "trees", "min": 1, "level": "warning", "message": "Belum ada tegakan yang dicatat di plot ini." },
          { "id": "mg-dbh-tree", "type": "rowRule", "table": "trees", "when": { "column": "category", "equals": "Pohon" }, "column": "dbh", "op": ">=", "value": 10, "level": "warning", "message": "Baris {rows}: kategori Pohon dengan DBH < 10 cm. Periksa kategori sesuai pedoman yang dipakai." },
          { "id": "mg-dbh-sapling", "type": "rowRule", "table": "trees", "when": { "column": "category", "equals": "Pancang" }, "column": "dbh", "op": "<", "value": 10, "level": "warning", "message": "Baris {rows}: kategori Pancang dengan DBH ≥ 10 cm." },
          { "id": "mg-dbh-required", "type": "rowRule", "table": "trees", "when": { "column": "category", "in": ["Pohon", "Pancang"] }, "column": "dbh", "op": "present", "level": "error", "message": "Baris {rows}: DBH wajib untuk pohon dan pancang." },
          { "id": "mg-photo", "type": "photoMin", "category": "plot", "min": 1, "level": "error", "message": "Minimal 1 foto plot sebagai bukti MRV." },
          { "id": "mg-not-future", "type": "notFuture", "field": "observedAt", "level": "error", "message": "Waktu pengamatan berada di masa depan." }
