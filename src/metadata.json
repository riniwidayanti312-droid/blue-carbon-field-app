            { "id": "mgc-gps-bounds", "type": "gpsInBounds", "field": "gps", "level": "error", "message": "Koordinat berada di luar {bounds}." },
            { "id": "mgc-photo", "type": "photoMin", "category": "sediment", "min": 1, "level": "error", "message": "Minimal 1 foto core/sedimen." },
