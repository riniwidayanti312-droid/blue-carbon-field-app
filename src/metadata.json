  "sampleCode": {
    "pattern": "{ECO}-{YEAR}-{SITE}-{SEQ}",
    "seqPad": 3,
    "qrPrefix": "BCFA",
    "tokens": "ECO = kode ekosistem, YEAR = tahun pengambilan, SITE = kode lokasi survei, TYPE = kode jenis sampel, SEQ = nomor urut"
  },
  "sync": {
    "mode": "auto",
    "collection": "bcfa_records",
    "configDoc": "bcfa_config/metadata",
    "restEndpoint": "",
    "supabaseUrl": "https://dgijsrvnattwiunyguay.supabase.co",
    "supabaseAnonKey": "sb_publishable_AFVM7I0a5fZaLoTAI_ExpQ_VO0Arkkt",
    "supabaseTable": "bcfa_records",
    "photoMaxPx": 1000,
    "photoQuality": 0.62,
    "thumbPx": 220
  },
  "ai": { "function": "identify-species" },
  "gps": {
    "bounds": { "latMin": -11.5, "latMax": 6.5, "lonMin": 94.5, "lonMax": 141.5 },
    "boundsLabel": "wilayah Indonesia",
    "timeoutMs": 20000
  },
  "labStatus": [
    { "code": "FIELD", "label": "Dikemas di lapangan" },
    { "code": "TRANSIT", "label": "Dalam pengiriman" },
    { "code": "RECEIVED", "label": "Diterima laboratorium" },
    { "code": "ANALYSIS", "label": "Dalam analisis" },
    { "code": "RESULT", "label": "Hasil tersedia" },
    { "code": "VERIFIED", "label": "Diverifikasi (QA/QC)" }
  ],
  "photoCategories": [
    { "code": "plot", "label": "Plot / kuadran" },
    { "code": "transect", "label": "Transek" },
    { "code": "sediment", "label": "Sedimen / core" },
    { "code": "sample", "label": "Sampel & label" },
    { "code": "species", "label": "Spesimen jenis" },
    { "code": "site", "label": "Lanskap lokasi" }
  ],
  "lists": {
    "substrate": ["Lumpur", "Lumpur berpasir", "Pasir berlumpur", "Pasir", "Pasir kasar", "Pecahan karang", "Batu"],
    "tide": ["Surut", "Menuju surut", "Pasang", "Menuju pasang"],
    "treatment": ["Dilabel ganda (dalam & luar)", "Kantong ziplock", "Didinginkan 4 °C (cool box)", "Dibekukan", "Dikeringkan udara", "Dipotong per interval di lapangan", "Dibilas air tawar"],
    "storageTemp": ["Suhu ruang", "Cool box ±4 °C", "Beku ≤ −18 °C"],
    "program": ["Inventarisasi baseline", "Monitoring berkala", "Verifikasi MRV", "Rehabilitasi / restorasi", "Penelitian"]
  },
  "surveyForm": {
    "fields": [
      { "key": "title", "label": "Nama survei", "type": "text", "required": true, "placeholder": "Survei lamun Alor – November 2026" },
      { "key": "ecosystem", "label": "Ekosistem", "type": "ecosystem", "required": true },
      { "key": "program", "label": "Tujuan kegiatan", "type": "select", "optionsFrom": "program" },
      { "key": "province", "label": "Provinsi", "type": "text", "required": true },
      { "key": "regency", "label": "Kabupaten/Kota", "type": "text", "required": true },
      { "key": "siteName", "label": "Nama lokasi", "type": "text", "required": true, "placeholder": "Teluk Kabola" },
      { "key": "siteCode", "label": "Kode lokasi", "type": "text", "required": true, "pattern": "^[A-Z0-9]{2,8}$", "patternHint": "2–8 huruf kapital/angka, contoh ALOR", "uppercase": true, "help": "Dipakai di kode sampel, contoh LM-2026-ALOR-001." },
      { "key": "startDate", "label": "Tanggal mulai", "type": "date", "required": true, "default": "today" },
      { "key": "endDate", "label": "Tanggal selesai", "type": "date" },
      { "key": "teamLeader", "label": "Ketua tim", "type": "text", "required": true, "default": "user" },
      { "key": "teamMembers", "label": "Anggota tim", "type": "textarea", "placeholder": "Satu nama per baris" },
      { "key": "institution", "label": "Instansi", "type": "text", "default": "Direktorat Konservasi Ekosistem – KKP" },
      { "key": "notes", "label": "Catatan", "type": "textarea" }
    ],
    "rules": [
      { "id": "survey-dates", "type": "compare", "a": "startDate", "op": "<=", "b": "endDate", "level": "error", "message": "Tanggal selesai lebih awal dari tanggal mulai." }
    ]
  },
  "ecosystems": [
    {
      "code": "LM",
      "key": "lamun",
      "label": "Lamun",
      "enabled": true,
      "color": "#2E7D4F",
      "observation": {
        "label": "Kuadran lamun",
        "titleField": "stationCode",
        "subtitleFields": ["transect", "quadratPos"],
        "fields": [
          { "key": "stationCode", "label": "Stasiun", "type": "text", "required": true, "placeholder": "ST1", "uppercase": true },
          { "key": "transect", "label": "Transek", "type": "text", "placeholder": "T1", "uppercase": true },
          { "key": "quadratPos", "label": "Posisi kuadran pada transek", "type": "number", "unit": "m", "min": 0, "max": 100, "step": 1 },
          { "key": "quadratSize", "label": "Ukuran kuadran", "type": "select", "options": ["50 × 50 cm", "25 × 25 cm", "1 × 1 m"], "default": "50 × 50 cm" },
          { "key": "observedAt", "label": "Waktu pengamatan", "type": "datetime", "required": true, "default": "now" },
          { "key": "gps", "label": "Koordinat kuadran", "type": "gps", "required": true },
          { "key": "waterDepth", "label": "Kedalaman air", "type": "number", "unit": "m", "min": 0, "max": 30, "step": 0.1 },
          { "key": "tide", "label": "Kondisi pasut", "type": "select", "optionsFrom": "tide" },
          { "key": "substrate", "label": "Substrat", "type": "select", "optionsFrom": "substrate", "required": true },
          { "key": "totalCover", "label": "Tutupan lamun total", "type": "number", "unit": "%", "min": 0, "max": 100, "step": 1, "required": true },
          { "key": "speciesCover", "label": "Tutupan per jenis", "type": "repeatTable", "addLabel": "Tambah jenis", "columns": [
            { "key": "species", "label": "Jenis", "type": "species", "required": true },
            { "key": "cover", "label": "Tutupan", "type": "number", "unit": "%", "min": 0, "max": 100, "step": 1, "required": true },
            { "key": "shoots", "label": "Tegakan", "type": "number", "unit": "per kuadran", "min": 0, "max": 5000, "step": 1 }
          ] },
          { "key": "canopyHeight", "label": "Tinggi kanopi rata-rata", "type": "number", "unit": "cm", "min": 0, "max": 200, "step": 0.5 },
          { "key": "epiphyte", "label": "Epifit / makroalga", "type": "select", "options": ["Tidak ada", "Sedikit", "Sedang", "Banyak"] },
          { "key": "photos", "label": "Foto", "type": "photos", "categories": ["plot", "transect", "species", "site"] },
          { "key": "notes", "label": "Catatan", "type": "textarea" }
        ],
        "rules": [
          { "id": "lm-gps", "type": "gpsPresent", "field": "gps", "level": "error", "message": "Koordinat belum diambil." },
          { "id": "lm-gps-bounds", "type": "gpsInBounds", "field": "gps", "level": "error", "message": "Koordinat berada di luar {bounds}. Periksa tanda minus pada lintang." },
          { "id": "lm-gps-acc", "type": "gpsAccuracy", "field": "gps", "max": 15, "level": "warning", "message": "Akurasi GPS {value} m, lebih besar dari batas {max} m. Tunggu sinyal lebih stabil bila memungkinkan." },
          { "id": "lm-cover-sum", "type": "sumCompare", "table": "speciesCover", "column": "cover", "op": "<=", "value": 100, "level": "error", "message": "Jumlah tutupan per jenis {sum}% melebihi 100%." },
          { "id": "lm-cover-match", "type": "sumCompare", "table": "speciesCover", "column": "cover", "op": "approx", "field": "totalCover", "tolerance": 10, "level": "warning", "message": "Jumlah tutupan per jenis ({sum}%) berbeda jauh dari tutupan total ({target}%)." },
          { "id": "lm-species-rows", "type": "minRows", "table": "speciesCover", "min": 1, "when": { "field": "totalCover", "gt": 0 }, "level": "error", "message": "Tutupan total lebih dari 0%, tetapi belum ada jenis yang dicatat." },
          { "id": "lm-photo-plot", "type": "photoMin", "category": "plot", "min": 1, "level": "error", "message": "Minimal 1 foto plot/kuadran sebagai bukti MRV." },
          { "id": "lm-not-future", "type": "notFuture", "field": "observedAt", "level": "error", "message": "Waktu pengamatan berada di masa depan." }
        ]
      },
      "sampleTypes": [
        {
          "code": "CORE",
          "label": "Core sedimen",
          "fields": [
            { "key": "linkedObs", "label": "Kuadran asal", "type": "obsRef", "help": "Koordinat kuadran disalin otomatis bila koordinat sampel masih kosong." },
            { "key": "collectedAt", "label": "Waktu pengambilan", "type": "datetime", "required": true, "default": "now" },
            { "key": "gps", "label": "Koordinat titik core", "type": "gps", "required": true },
            { "key": "corerType", "label": "Alat core", "type": "select", "options": ["Pipa PVC", "Russian peat corer", "Auger", "Lainnya"], "default": "Pipa PVC" },
            { "key": "coreDiameter", "label": "Diameter dalam core", "type": "number", "unit": "cm", "min": 2, "max": 15, "step": 0.1 },
            { "key": "penetrationDepth", "label": "Kedalaman tembus core", "type": "number", "unit": "cm", "min": 1, "max": 300, "step": 0.5, "required": true },
            { "key": "recoveredLength", "label": "Panjang sedimen terambil", "type": "number", "unit": "cm", "min": 1, "max": 300, "step": 0.5, "required": true },
            { "key": "compaction", "label": "Kompaksi", "type": "computed", "formula": "compaction" },
