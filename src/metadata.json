            { "key": "category", "label": "Kategori", "type": "select", "options": ["Pohon", "Pancang", "Semai"], "required": true },
            { "key": "dbh", "label": "DBH", "type": "number", "unit": "cm", "min": 0, "max": 300, "step": 0.1 },
            { "key": "height", "label": "Tinggi", "type": "number", "unit": "m", "min": 0, "max": 50, "step": 0.1 },
            { "key": "condition", "label": "Kondisi", "type": "select", "options": ["Hidup", "Mati", "Rusak"], "default": "Hidup" }
          ] },
          { "key": "photos", "label": "Foto", "type": "photos", "categories": ["plot", "site", "species"] },
