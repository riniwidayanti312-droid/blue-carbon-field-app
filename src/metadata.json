            { "key": "depthBottom", "label": "Kedalaman bawah subsampel", "type": "number", "unit": "cm", "min": 0, "max": 300, "step": 0.5, "required": true },
            { "key": "thickness", "label": "Tebal interval", "type": "computed", "formula": "thickness" },
            { "key": "sedimentType", "label": "Jenis sedimen", "type": "select", "optionsFrom": "substrate" },
            { "key": "treatment", "label": "Perlakuan sampel", "type": "multiselect", "optionsFrom": "treatment", "required": true },
            { "key": "storageTemp", "label": "Penyimpanan", "type": "select", "optionsFrom": "storageTemp" },
            { "key": "photos", "label": "Foto", "type": "photos", "categories": ["sediment", "sample"] },
            { "key": "notes", "label": "Catatan", "type": "textarea" }
          ],
          "labFields": [
            { "key": "labStatus", "label": "Status pengujian", "type": "select", "optionsFrom": "labStatus", "required": true, "default": "FIELD" },
            { "key": "labName", "label": "Laboratorium", "type": "text" },
            { "key": "labReceivedAt", "label": "Tanggal diterima lab", "type": "date" },
            { "key": "corgMethod", "label": "Metode Corg", "type": "select", "options": ["Loss on Ignition (LOI)", "Walkley-Black", "Elemental analyzer (CHN)"] },
            { "key": "bulkDensity", "label": "Bulk density", "type": "number", "unit": "g/cm³", "min": 0.05, "max": 2.6, "step": 0.001 },
            { "key": "corgPercent", "label": "Karbon organik (Corg)", "type": "number", "unit": "%", "min": 0, "max": 60, "step": 0.01 },
            { "key": "soilCarbon", "label": "Stok karbon interval", "type": "computed", "formula": "soilCarbon" },
            { "key": "labAnalyst", "label": "Analis", "type": "text" },
            { "key": "labNotes", "label": "Catatan lab", "type": "textarea" }
          ],
          "rules": [
            { "id": "core-depth", "type": "compare", "a": "depthTop", "op": "<", "b": "depthBottom", "level": "error", "message": "Kedalaman atas harus lebih kecil dari kedalaman bawah." },
            { "id": "core-recovery", "type": "compare", "a": "recoveredLength", "op": "<=", "b": "penetrationDepth", "level": "error", "message": "Panjang sedimen terambil tidak boleh melebihi kedalaman tembus." },
            { "id": "core-interval", "type": "compare", "a": "depthBottom", "op": "<=", "b": "penetrationDepth", "level": "warning", "message": "Interval subsampel lebih dalam dari kedalaman tembus core." },
            { "id": "core-gps", "type": "gpsPresent", "field": "gps", "level": "error", "message": "Koordinat titik core belum diambil." },
            { "id": "core-gps-bounds", "type": "gpsInBounds", "field": "gps", "level": "error", "message": "Koordinat berada di luar {bounds}." },
            { "id": "core-photo", "type": "photoMin", "category": "sediment", "min": 1, "level": "error", "message": "Minimal 1 foto core/sedimen." },
            { "id": "core-bd", "type": "requiredWhen", "field": "bulkDensity", "when": { "field": "labStatus", "in": ["RESULT", "VERIFIED"] }, "level": "error", "message": "Status {status}, tetapi bulk density belum diisi." },
            { "id": "core-corg", "type": "requiredWhen", "field": "corgPercent", "when": { "field": "labStatus", "in": ["RESULT", "VERIFIED"] }, "level": "error", "message": "Status {status}, tetapi Corg belum diisi." },
            { "id": "core-corg-high", "type": "compare", "a": "corgPercent", "op": "<=", "value": 20, "level": "warning", "message": "Corg {value}% di atas kisaran umum sedimen lamun. Periksa ulang satuan atau hasil lab." }
          ],
          "carbon": { "formula": "soilCarbon" }
        },
