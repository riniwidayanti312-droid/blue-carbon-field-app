            { "id": "mgc-corg", "type": "requiredWhen", "field": "corgPercent", "when": { "field": "labStatus", "in": ["RESULT", "VERIFIED"] }, "level": "error", "message": "Status {status}, tetapi Corg belum diisi." },
            { "id": "mgc-corg-high", "type": "compare", "a": "corgPercent", "op": "<=", "value": 45, "level": "warning", "message": "Corg {value}% sangat tinggi. Periksa ulang satuan atau hasil lab." }
